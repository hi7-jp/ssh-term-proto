<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#000000"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/connectBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Spinner
                    android:id="@+id/spinnerPresets"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnSavePreset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="保存" />

                <Button
                    android:id="@+id/btnDeletePreset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="削除" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editHost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:hint="host"
                    android:textColor="#00FF66"
                    android:textColorHint="#336633"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/editPort"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="port"
                    android:text="22"
                    android:textColor="#00FF66"
                    android:textColorHint="#336633"
                    android:inputType="number" />
            </LinearLayout>

            <EditText
                android:id="@+id/editUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="username"
                android:textColor="#00FF66"
                android:textColorHint="#336633"
                android:inputType="text" />

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="password"
                android:textColor="#00FF66"
                android:textColorHint="#336633"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connect" />
        </LinearLayout>

        <!-- Replaces the old ScrollView+TextView log and the one-line command
             row. The view draws the ANSI character grid itself and is also the
             key-input target (see TerminalView). -->
        <jp.hi7.sshtermproto.TerminalView
            android:id="@+id/terminalView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Keys a phone keyboard lacks (Esc / Tab / Ctrl / arrows ...).
             Buttons are added in MainActivity.buildExtraKeys(); shown only
             while a session is connected. -->
        <HorizontalScrollView
            android:id="@+id/extraKeys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/extraKeysRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Covers the whole screen until device-credential auth succeeds.
         Re-shown every time the activity resumes (see MainActivity). -->
    <LinearLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#000000"
        android:padding="24dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <TextView
            android:id="@+id/lockStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#00FF66"
            android:textSize="16sp"
            android:text="認証中..." />

        <Button
            android:id="@+id/btnRetryUnlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:text="再試行" />
    </LinearLayout>
</FrameLayout>
